<?xml version="1.0" encoding="utf-8"?>
<!-- IIS hosting for the API (requires the ASP.NET Core 8 Hosting Bundle). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers><add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" /></handlers>
      <aspNetCore processPath="dotnet" arguments=".\AvsWebsite.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables><environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" /></environmentVariables>
      </aspNetCore>
      <security><requestFiltering><requestLimits maxAllowedContentLength="26214400" /></requestFiltering></security>
    </system.webServer>
  </location>
</configuration>
